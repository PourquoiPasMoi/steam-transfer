{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Transfer",
  "version": "2.0.2",
  "identifier": "app.steamtransfer.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Steam Transfer",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "backgroundColor": "#14110f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://art.localhost https://art.localhost https://shared.cloudflare.steamstatic.com https://cdn.cloudflare.steamstatic.com https://steamcdn-a.akamaihd.net; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzRTU4RUJBOUZFNzUwQUUKUldTdVVPZWZ1bzdsNHg2bko5Y0R2YkVyZVNLaWxsQURHTFBLczRDenZzdWhYNWYrRXNrcnZDaVEK",
      "endpoints": [
        "https://github.com/PourquoiPasMoi/steam-transfer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
